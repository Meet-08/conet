# ─── Test Environment Configuration ────────────────────────────────────────
# NEVER commit real credentials.
# Copy this file to .env.test.local and fill in actual values for local dev.
# CI reads secrets from GitHub Actions repository secrets.

NODE_ENV=test
PORT=5001

# ─── Test Database ───────────────────────────────────────────────────────────
# Must point to an isolated test database.
# NEVER point this at the production Supabase project.
# Recommended: local PostgreSQL instance or a dedicated Supabase test project.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/conet_test

# ─── Prisma ──────────────────────────────────────────────────────────────────
# For unit/integration tests that mock Prisma, DATABASE_URL can be a dummy value.
# Only real DB tests (dbSetup.js) use TEST_DATABASE_URL.
DATABASE_URL=postgresql://postgres:1234@localhost:5432/conet_test
DIRECT_URL=postgresql://postgres:1234@localhost:5432/conet_test

# ─── Auth ────────────────────────────────────────────────────────────────────
# This must match TEST_JWT_SECRET in test/mocks/authMock.js
SUPABASE_JWT_SECRET=test-secret-do-not-use-in-production

# ─── Logging ─────────────────────────────────────────────────────────────────
# Silence request logs during tests to keep output clean
LOG_LEVEL=silent
